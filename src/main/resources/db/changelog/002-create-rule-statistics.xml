<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="2-create-rule-statistics" author="araz">
        <createTable tableName="rule_statistics">
            <column name="id" type="BIGSERIAL" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="rule_id" type="BIGINT">
                <constraints nullable="false" unique="true"
                             foreignKeyName="fk_rule_statistics_rule"
                             referencedTableName="rules"
                             referencedColumnNames="id"
                             deleteCascade="true"/>
            </column>
            <column name="hit_count" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="3-backfill-rule-statistics" author="araz">
        <sql>
            INSERT INTO rule_statistics (rule_id, hit_count)
            SELECT r.id, 0 FROM rules r
                                    LEFT JOIN rule_statistics rs ON rs.rule_id = r.id
            WHERE rs.id IS NULL;
        </sql>
    </changeSet>
</databaseChangeLog>